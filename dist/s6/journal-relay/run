#!/bin/sh
# Without journald (JOURNAL=no): listen on journald's client sockets in
# /run/systemd/journal and forward to rsyslog. dbus-broker-launch, the
# session bus of systemd --user, refuses to start without them.
# uinitconverter-journal-relay is a separate project; uinitconverter init --journal=no
# requires it. If it is missing anyway, report ready and idle so the boot
# goes on.
bin=/usr/libexec/uinitconverter/uinitconverter-journal-relay
if [ ! -x "$bin" ]; then
    echo "uinitconverter-journal-relay is not installed: no journald sockets" >&2
    echo >&3
    exec sleep infinity
fi
exec "$bin" --ready-fd 3
