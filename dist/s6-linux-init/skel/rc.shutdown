#!/bin/sh
# Shutdown: bring every s6-rc service down (dependencies respected).
# The marker stops sdcompatd from starting units beside this change
# (D-Bus activations during shutdown). The kernel log line marks where this
# shutdown starts for rc.shutdown.final.
# s6-linux-init-shutdownd waits for this script without a time limit, so a
# stop that never finishes would keep the machine up for good. After 3
# minutes s6-rc gives up (exit 2) and shutdownd kills what is left, as
# systemd ends a shutdown its unit stop timeouts couldn't.
mkdir -p /run/sdcompat && : > /run/sdcompat/shutting-down
echo "sdcompat: shutdown starts" > /dev/kmsg 2>/dev/null
s6-rc -v2 -t 180000 -bDa change
rc=$?
case $rc in
0) ;;
2) echo "sdcompat: services still not down after 180 s, killing the rest" > /dev/kmsg 2>/dev/null ;;
*) echo "sdcompat: s6-rc change exited $rc" > /dev/kmsg 2>/dev/null ;;
esac
exit "$rc"
