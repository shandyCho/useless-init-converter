#!/bin/sh -e
# s6-linux-init stage 2 for sdcompat (install into your s6-linux-init skel
# directory, then run s6-linux-init-maker).
rl="$1"
shift

# The initramfs mounts / read-only; the database lives in /var/lib/sdcompat.
mount -o remount,rw / || true

# Pick up unit files installed or enabled while the system was down.
if ! /usr/libexec/sdcompat/sdcompat reload --no-update; then
    echo "rc.init: sdcompat reload failed, booting the previous database" >&2
fi

s6-rc-init -c /var/lib/sdcompat/compiled -l /run/s6-rc /run/service

# Offline updates (dnf system-upgrade / dnf offline): like systemd's
# system-update generator, boot into system-update.target instead.
if [ -L /system-update ] || [ -e /system-update ] || [ -L /etc/system-update ]; then
    echo "rc.init: /system-update exists, booting the offline update" >&2
    rl=system-update
fi
exec /etc/s6-linux-init/current/scripts/runlevel "$rl"
