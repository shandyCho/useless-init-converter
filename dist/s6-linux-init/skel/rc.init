#!/bin/sh -e
# s6-linux-init stage 2 for uinitconverter (install into your s6-linux-init skel
# directory, then run s6-linux-init-maker).
rl="$1"
shift

# The initramfs mounts / read-only; the database lives in /var/lib/uinitconverter.
mount -o remount,rw / || true
# /var (or /var/lib) can be a filesystem of its own, such as Fedora Cloud's
# btrfs "var" subvolume, which the initramfs leaves alone: mount it from
# fstab before s6-rc-init reads the database. mount-fs's `mount -a` skips it.
for m in /var /var/lib /var/lib/uinitconverter; do
    if findmnt --fstab -n "$m" >/dev/null 2>&1 && ! mountpoint -q "$m"; then
        mount "$m" || echo "rc.init: mount $m failed" >&2
    fi
done

# The boot database is the set uinitconverter (or `s6 live install`) installed
# last; nothing is regenerated here. Unit files changed while the system
# was down (e.g. from a systemd boot) are picked up by the next
# `systemctl daemon-reload` or `initconvert reload`.
# Kernel command line option:
#   uinitconverter.db=previous   boot the database installed before the last one
db=/var/lib/uinitconverter/compiled
for opt in $(cat /proc/cmdline); do
    case $opt in
        uinitconverter.db=previous) db=/var/lib/uinitconverter/compiled.previous ;;
    esac
done
[ -e "$db" ] || db=/var/lib/uinitconverter/compiled
# The database itself, not the link: a reload that installs a database for
# the next boot only (it would restart an essential service) switches the
# link, and the live state must keep the database it runs.
db=$(readlink -f "$db")

s6-rc-init -c "$db" -l /run/s6-rc /run/service

# Offline updates (dnf system-upgrade / dnf offline): like systemd's
# system-update generator, boot into system-update.target instead.
if [ -L /system-update ] || [ -e /system-update ] || [ -L /etc/system-update ]; then
    echo "rc.init: /system-update exists, booting the offline update" >&2
    rl=system-update
fi
exec /etc/s6-linux-init/current/scripts/runlevel "$rl"
