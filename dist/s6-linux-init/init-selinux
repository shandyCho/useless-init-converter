#!/bin/sh
# Boot with init=/usr/sbin/init-selinux. Loads the SELinux policy (systemd
# normally does this as PID 1), then execs s6-linux-init so it starts in
# init_t. Label s6-linux-init's init as init_exec_t:
#   semanage fcontext -a -t init_exec_t '/etc/s6-linux-init/current/bin/init'
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
# The kernel starts PID 1 at 1024:4096 and every service inherits it. systemd
# gives services a hard limit of 524288 (soft stays 1024), and programs like
# cups raise their own soft limit up to it. Not worth failing a boot over.
# shellcheck disable=SC3045  # -H: bash and dash both have it
ulimit -Hn 524288 2>/dev/null || echo "init-selinux: can't raise the hard RLIMIT_NOFILE" >&2
# The kernel starts PID 1 with no core dumps (soft 0) and every service inherits
# it; systemd sets unlimited, and then systemd-coredump does the limiting.
# Survives the exec into init_t only through the policy module's rlimitinh rule.
# shellcheck disable=SC3045  # -S: bash and dash both have it
ulimit -Sc unlimited 2>/dev/null || echo "init-selinux: can't raise the soft RLIMIT_CORE" >&2
if ! /usr/sbin/load_policy -i; then
    echo "init-selinux: policy load failed" >&2
    grep -q '^SELINUX=enforcing' /etc/selinux/config && exec /bin/sh
fi
exec /etc/s6-linux-init/current/bin/init "$@"
