#!/bin/sh
# Early-boot helpers for the example s6 services in /etc/sdcompat/s6.
# They replace the systemd units that only make sense with systemd as PID 1
# (systemd-remount-fs, systemd-modules-load, the API filesystem mounts, ...).
# Review them for your machine before booting with them.
#
# Every step exits 0: s6-rc treats a failed oneshot as a failed dependency
# of everything after it, but these steps only degrade the system when they
# fail (a sysctl key, one tmpfiles line). Failures are logged instead.
set -u

warn() { echo "sdcompat early: $*" >&2; }

mnt() { # mnt FSTYPE TARGET OPTIONS
    mountpoint -q "$2" && return 0
    mkdir -p "$2"
    mount -t "$1" -o "$3" "$1" "$2"
}

case "${1:-}" in
mount-api)
    # Usually already mounted by the initramfs; harmless otherwise.
    mnt proc /proc nosuid,nodev,noexec
    mnt sysfs /sys nosuid,nodev,noexec
    mnt devtmpfs /dev nosuid,mode=0755
    mnt tmpfs /run nosuid,nodev,mode=0755
    mnt cgroup2 /sys/fs/cgroup nosuid,nodev,noexec,nsdelegate
    mnt devpts /dev/pts nosuid,noexec,gid=5,mode=0620,ptmxmode=000
    mnt tmpfs /dev/shm nosuid,nodev,mode=1777
    mnt securityfs /sys/kernel/security nosuid,nodev,noexec 2>/dev/null
    mnt bpf /sys/fs/bpf nosuid,nodev,noexec,mode=0700 2>/dev/null
    mnt pstore /sys/fs/pstore nosuid,nodev,noexec 2>/dev/null
    # PID 1's too: the kernel default is private, and units, flatpak and
    # containers make / a slave in their own namespaces, so a slave of a
    # private tree never sees later mounts (a USB stick under /run/media).
    # Filesystems mounted later (mount-fs) are shared as their parent is.
    mount --make-rshared / || warn "mount --make-rshared / failed"
    # systemd (PID 1) creates userdb for the services that serve user records
    # there (gdm's org.gnome.DisplayManager); it needs its own label, not
    # /run/systemd's.
    mkdir -p /run/systemd/userdb
    # Also PID 1's: systemd-executor bind-mounts a unit's new root on
    # mount-rootfs and can't create it itself in a user manager's user
    # namespace, so every PrivateTmp/ProtectSystem/... user unit fails with
    # 226/NAMESPACE without it (oo7-daemon). inaccessible/chr and blk are
    # its fallback for nodes it can't mknod there.
    [ -d /run/systemd/mount-rootfs ] || mkdir -m 0555 /run/systemd/mount-rootfs
    if [ ! -d /run/systemd/inaccessible ]; then
        mkdir -m 0755 /run/systemd/inaccessible
        install -m 0000 /dev/null /run/systemd/inaccessible/reg
        mkdir -m 0000 /run/systemd/inaccessible/dir
        mkfifo -m 0000 /run/systemd/inaccessible/fifo
        mknod -m 0000 /run/systemd/inaccessible/chr c 0 0
        mknod -m 0000 /run/systemd/inaccessible/blk b 0 0
    fi
    # Also PID 1's (systemd's mount-setup): devtmpfs has no /dev/fd and
    # stdio links. A systemd initramfs leaves them in the /dev it hands
    # over; the s6 one (--boot-only-s6) doesn't, and without /dev/fd every
    # bash process substitution fails ("/dev/fd/63: No such file").
    for l in fd:/proc/self/fd stdin:/proc/self/fd/0 stdout:/proc/self/fd/1 stderr:/proc/self/fd/2; do
        [ -e "/dev/${l%%:*}" ] || [ -L "/dev/${l%%:*}" ] || ln -s "${l#*:}" "/dev/${l%%:*}" \
            || warn "can't create /dev/${l%%:*}"
    done
    if [ -e /proc/kcore ] && [ ! -L /dev/core ] && [ ! -e /dev/core ]; then
        ln -s /proc/kcore /dev/core
    fi
    # kmod-static-nodes and systemd-tmpfiles-setup-dev-early, which EXCLUDE
    # drops: the nodes of modules that load when their node is first opened
    # (/dev/net/tun for podman and VPNs, /dev/uinput, /dev/vhost-net). The
    # initramfs made only those of its own modules; without these, opening
    # one fails with ENOENT and the module never loads.
    kver=$(uname -r)
    if [ -s "/lib/modules/$kver/modules.devname" ] && [ -x /usr/bin/kmod ]; then
        mkdir -p /run/tmpfiles.d
        /usr/bin/kmod static-nodes --format=tmpfiles --output=/run/tmpfiles.d/static-nodes.conf \
            || warn "kmod static-nodes exited $?"
    fi
    /usr/bin/systemd-tmpfiles --prefix=/dev --create --boot --graceful
    rc=$?
    case $rc in 0|65|73) ;; *) warn "systemd-tmpfiles --prefix=/dev exited $rc" ;; esac
    if [ -e /sys/fs/selinux/enforce ] && command -v restorecon >/dev/null; then
        # /run, but not what s6-linux-init and s6-rc-init made there before
        # us: init_t's type transitions gave them init_var_run_t, and
        # resetting them to the file_contexts default (var_run_t without a
        # filecon) is what kept needing fixes (s6-rc-update denied its
        # renames, the catch-all fifo, the scan directory).
        restorecon -R /dev 2>/dev/null
        restorecon /run 2>/dev/null
        for e in /run/* /run/.[!.]*; do
            [ -e "$e" ] || continue
            case ${e#/run/} in
            service | uncaught-logs | s6-rc | s6-rc:* | s6-linux-init*) continue ;;
            esac
            restorecon -R "$e" 2>/dev/null
        done
    fi
    [ -s /etc/machine-id ] || systemd-machine-id-setup 2>/dev/null || true
    ;;
mount-fs)
    # fsck of the root filesystem is not done here; the initramfs normally
    # handles it (rd.fsck / fsck.mode kernel options).
    # As systemd-remount-fs: the options fstab gives the root filesystem
    # (rw unless it says ro); "remount" with no device reads them from
    # fstab. Without an fstab line, read-write as before.
    if findmnt --fstab -n / >/dev/null 2>&1; then
        mount -o remount / 2>/dev/null || warn "remount of / with its fstab options failed"
    else
        mount -o remount,rw / 2>/dev/null
    fi
    mount -a -O no_netdev || warn "mount -a: some filesystems did not mount"
    swapon -a 2>/dev/null
    ;;
umount-fs)
    swapoff -a 2>/dev/null
    sync
    ;;
udev-trigger)
    udevadm trigger --type=subsystems --action=add
    udevadm trigger --type=devices --action=add
    udevadm settle --timeout=60 || warn "udevadm settle timed out"
    ;;
modules-load)
    # /etc overrides /run overrides /usr/lib by file name, like systemd.
    seen=" "
    for d in /etc/modules-load.d /run/modules-load.d /usr/lib/modules-load.d; do
        for f in "$d"/*.conf; do
            [ -e "$f" ] || continue
            b=${f##*/}
            case "$seen" in *" $b "*) continue ;; esac
            seen="$seen$b "
            sed -e 's/[#;].*//' "$f" | while read -r m; do
                [ -n "$m" ] && modprobe -b "$m"
            done
        done
    done
    ;;
hostname)
    h=$(sed -n '/^[^#]/{p;q}' /etc/hostname 2>/dev/null)
    hostname "${h:-localhost}"
    ;;
tmpfiles)
    # Like systemd-tmpfiles-setup.service: SuccessExitStatus=DATAERR CANTCREAT
    /usr/bin/systemd-tmpfiles --create --remove --boot --exclude-prefix=/dev
    rc=$?
    case $rc in 0|65|73) ;; *) warn "systemd-tmpfiles exited $rc" ;; esac
    ;;
sysusers)
    /usr/bin/systemd-sysusers || warn "systemd-sysusers exited $?"
    ;;
sysctl)
    /usr/sbin/sysctl -q --system || warn "sysctl --system exited $?"
    ;;
vconsole)
    # Keymap and font from /etc/vconsole.conf. udev's 90-vconsole.rules asks
    # for systemd-vconsole-setup.service for each console during the
    # trigger, before sdcompatd is up to start it, so run it here once
    # udev has settled. Later consoles go through sdcompatd.
    [ -e /dev/tty0 ] || exit 0
    v=/usr/lib/systemd/systemd-vconsole-setup
    [ -x "$v" ] || exit 0
    "$v" || warn "systemd-vconsole-setup exited $?"
    ;;
rfkill | rfkill-save)
    # In place of systemd-rfkill (socket-activated by udev for /dev/rfkill):
    # restore each radio's soft block at boot, save it at shutdown. The
    # state lives in systemd-rfkill's files (/var/lib/systemd/rfkill/
    # ID_PATH:TYPE, "0" or "1"), so the systemd boot entry shares it.
    # Devices that appear after the boot's udev settle keep their state.
    dir=/var/lib/systemd/rfkill
    [ -d /sys/class/rfkill ] || exit 0
    if [ "$1" = rfkill ]; then
        case " $(cat /proc/cmdline) " in *" systemd.restore_state=0 "*) exit 0 ;; esac
        command -v rfkill >/dev/null || { warn "rfkill (util-linux) not found"; exit 0; }
    else
        mkdir -p "$dir"
        command -v restorecon >/dev/null && restorecon "$dir" >/dev/null 2>&1
    fi
    for d in /sys/class/rfkill/rfkill*; do
        [ -r "$d/type" ] || continue
        path=$(udevadm info -q property -p "$d" 2>/dev/null | sed -n 's/^ID_PATH=//p')
        # systemd-rfkill skips devices without ID_PATH too.
        [ -n "$path" ] || continue
        f=$dir/$path:$(cat "$d/type")
        if [ "$1" = rfkill ]; then
            [ -r "$f" ] || continue
            case $(cat "$f") in
            1) rfkill block "${d##*/rfkill}" || warn "rfkill block ${d##*/}" ;;
            0) rfkill unblock "${d##*/rfkill}" || warn "rfkill unblock ${d##*/}" ;;
            esac
        else
            printf '%s\n' "$(cat "$d/soft")" >"$f" || warn "saving $f failed"
        fi
    done
    ;;
resolv)
    # RESOLVED=no (sdcompat init --resolved=no): systemd-resolved does not
    # run on this boot. NetworkManager handles DNS itself, and the stub file
    # /etc/resolv.conf links to points at NetworkManager's copy. All of it
    # is in /run, so the systemd boot keeps using resolved.
    nm=/run/NetworkManager
    mkdir -p "$nm/conf.d"
    cat >"$nm/conf.d/99-sdcompat-no-resolved.conf" <<'EOF'
# Written at boot by sdcompat's "resolv" s6 service (RESOLVED=no).
# rc-manager=symlink: Fedora's resolvconf is resolvectl, i.e. resolved.
[main]
dns=default
rc-manager=symlink
EOF
    t=$(readlink -m /etc/resolv.conf)
    case $t in
    /run/systemd/resolve/*)
        mkdir -p "${t%/*}"
        ln -sfn "$nm/resolv.conf" "$t"
        ;;
    esac
    command -v restorecon >/dev/null && restorecon -R "$nm" /run/systemd/resolve 2>/dev/null
    ;;
*)
    echo "usage: $0 mount-api|mount-fs|umount-fs|udev-trigger|modules-load|hostname|tmpfiles|sysusers|sysctl|vconsole|resolv" >&2
    exit 2
    ;;
esac
exit 0
