#!/bin/sh
# initconvert-user-setup: turn uinitconverter's s6 user manager on or off for
# user@UID.service (package uinitconverter-user). It is opt-in and not
# recommended: it reimplements systemd --user and can't be kept in step with
# its changes. On the s6 boot USER_MANAGER= alone decides (unset: systemd
# --user); this writes it too.
#
#   initconvert-user-setup on       # the s6 manager from each user's next login
#   initconvert-user-setup off      # systemd --user from each user's next login
#   initconvert-user-setup status   # the setting, and what each user@ runs now
#
# `on` writes user@.service's drop-in
# /etc/systemd/system/user@.service.d/90-uinitconverter.conf and
# USER_MANAGER=s6 in /etc/uinitconverter/uinitconverter.conf; `off` removes the
# drop-in and writes USER_MANAGER=systemd. Running managers keep running until
# their user's last session ends (log out, or reboot). For one boot,
# uinitconverter.user_manager=systemd on the kernel command line runs
# systemd --user whatever this says. If the s6 manager fails a user, that user
# gets systemd --user for the rest of the boot.
#
# UINITCONVERTER_SETUP_ROOT=DIR works under DIR instead of / (also /proc and
# /sys for status) and skips systemctl (tests/user-setup.sh).
set -eu

ROOT=${UINITCONVERTER_SETUP_ROOT:-}
MANAGER=/usr/libexec/uinitconverter/initconvert-user-manager
DROPIN=$ROOT/etc/systemd/system/user@.service.d/90-uinitconverter.conf
CONF=$ROOT/etc/uinitconverter/uinitconverter.conf

die() { echo "initconvert-user-setup: $*" >&2; exit 1; }
usage() { sed -n '6,8s/^# \{0,1\}//p' "$0" >&2; exit 2; }

# The USER_MANAGER= line set to $1, replacing an uncommented one or appended.
set_user_manager() {
    mkdir -p "$(dirname "$CONF")"
    [ -e "$CONF" ] || : >"$CONF"
    if grep -q '^USER_MANAGER=' "$CONF"; then
        sed -i "s/^USER_MANAGER=.*/USER_MANAGER=$1/" "$CONF"
    else
        printf 'USER_MANAGER=%s\n' "$1" >>"$CONF"
    fi
}

reload() {
    [ -n "$ROOT" ] && return 0
    systemctl daemon-reload || echo "initconvert-user-setup: systemctl daemon-reload failed; run it before the next login" >&2
}

need_root() {
    [ -n "$ROOT" ] || [ "$(id -u)" = 0 ] || die "run it as root (sudo initconvert-user-setup $1)"
}

# The reason in user $1's fallback record, as initconvertd reads it: the
# user's own regular file in /run/uinitconverter-user (writable by all), or
# else in their runtime directory.
fallback() {
    for f in "$ROOT/run/uinitconverter-user/$1" "$ROOT/run/user/$1/uinitconverter-fallback/$1"; do
        if [ -f "$f" ] && [ ! -L "$f" ] && [ "$(stat -c %u "$f" 2>/dev/null)" = "$1" ]; then
            head -1 "$f"
            return
        fi
    done
}

setting() {
    sed -n 's/^USER_MANAGER=//p' "$CONF" 2>/dev/null | tail -1
}

case ${1:-} in
    on)
        need_root on
        [ -e "$ROOT$MANAGER" ] || die "$MANAGER is missing (dnf install uinitconverter-user)"
        mkdir -p "$(dirname "$DROPIN")"
        cat >"$DROPIN" <<EOF
# Written by \`initconvert-user-setup on\`, removed by \`initconvert-user-setup off\`
# and when uinitconverter-user is removed: uinitconverter's s6 user manager
# runs user@UID.service. uinitconverter.user_manager=systemd on the kernel
# command line runs systemd --user for one boot.
[Service]
ExecStart=
ExecStart=$MANAGER
EOF
        set_user_manager s6
        reload
        echo "The s6 user manager runs each user's manager from their next login (log out, or reboot)."
        echo "Not recommended: it can't follow systemd --user's changes, so a GNOME or systemd update may break login. 'initconvert-user-setup off' goes back." >&2
        ;;
    off)
        need_root off
        rm -f "$DROPIN"
        rmdir "$(dirname "$DROPIN")" 2>/dev/null || true
        [ -e "$CONF" ] && set_user_manager systemd
        reload
        echo "systemd --user runs each user's manager from their next login (log out, or reboot)."
        ;;
    status)
        if [ -e "$DROPIN" ]; then echo "drop-in:      $DROPIN"; else echo "drop-in:      none (off on a systemd boot)"; fi
        # Unset: systemd --user on either boot (Config::user_manager_now).
        echo "USER_MANAGER: $(setting || true)$( [ -z "$(setting || true)" ] && echo "unset (systemd)")"
        k=$(tr ' ' '\n' 2>/dev/null <"$ROOT/proc/cmdline" | sed -n 's/^uinitconverter\.user_manager=//p' | tail -1)
        [ -n "$k" ] && echo "this boot:    uinitconverter.user_manager=$k on the kernel command line"
        for p in "$ROOT"/sys/fs/cgroup/user.slice/user-*.slice/user@*.service/init.scope/cgroup.procs; do
            [ -r "$p" ] || continue
            uid=${p#*/user@}
            uid=${uid%%.service*}
            # On the s6 boot user@'s first process is initconvert-runner and
            # the manager its child, so every process of init.scope counts.
            m="" first=""
            for pid in $(cat "$p"); do
                exe=$(basename "$(readlink "$ROOT/proc/$pid/exe" 2>/dev/null)" 2>/dev/null || true)
                exe=${exe% (deleted)}
                [ -n "$first" ] || first=$exe
                case $exe in
                    initconvertd) m="the s6 user manager"; break ;;
                    systemd) m="systemd --user" ;;
                esac
            done
            [ -n "$first" ] || continue
            [ -n "$m" ] || m=${first:-unknown}
            fb=$(fallback "$uid")
            echo "user@$uid:    $m${fb:+ (fell back: $fb)}"
        done
        ;;
    *) usage ;;
esac
