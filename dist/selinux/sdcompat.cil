; SELinux policy module for booting with s6 + sdcompat.
;
; systemd runs as init_t and every service enters its own domain through the
; policy's init_t transitions (chronyd_exec_t -> chronyd_t, xdm_exec_t ->
; xdm_t, user@.service -> the user's domain, ...). Under s6 the same holds only
; if the whole supervision tree stays in init_t: init_t executing a bin_t
; program becomes unconfined_service_t, so the s6, s6-rc, s6-linux-init and
; execline programs and sdcompat's own binaries are labelled init_exec_t, like
; /usr/lib/systemd/systemd. Run from any other domain they keep that domain
; (unconfined_t stays unconfined_t).
;
; /run/sdcompat holds the notify sockets services write to and is labelled
; like systemd's /run/systemd.
;
; Load:   semodule -i sdcompat.cil, then restorecon the files below
; Remove: semodule -r sdcompat

(filecon "/usr/bin/s6-[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/bin/ucspilogd" file (system_u object_r init_exec_t ((s0) (s0))))
; execline is built as one multicall binary (dist/rpm/execline.spec), so this
; one file covers every execline command, whatever a release names them.
(filecon "/usr/bin/execline" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/libexec/execline/[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/libexec/s6/[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/libexec/s6-rc/[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/libexec/sdcompat/[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))

(filecon "/run/sdcompat(/.*)?" any (system_u object_r init_var_run_t ((s0) (s0))))
(typetransition init_t var_run_t dir "sdcompat" init_var_run_t)
;
; s6-linux-init's catch-all logger (s6-log, init_t) keeps its log in
; /run/uncaught-logs and rotates it by renaming "current". init_t may not
; rename var_run_t files; label it like /run/systemd. Without this the
; logger retries forever under enforcing and stops reading its fifo.
(filecon "/run/uncaught-logs(/.*)?" any (system_u object_r init_var_run_t ((s0) (s0))))
(typetransition init_t var_run_t dir "uncaught-logs" init_var_run_t)
;
; s6-rc's live directories (/run/s6-rc -> s6-rc:s6-rc-init:XXXXXX, and the
; s6-rc:s6-rc-update:XXXXXX that replace it). init_t creates them as
; init_var_run_t, but `early` runs restorecon -R /run after s6-rc-init, which
; made them var_run_t. s6-rc-update (daemon-reload) renames each running
; service's files aside before copying the new ones in; denied, it failed,
; could not roll back, and left that service directory in the new live dir.
(filecon "/run/s6-rc(:[^/]+)?(/.*)?" any (system_u object_r init_var_run_t ((s0) (s0))))
;
; /var/lib/sdcompat holds the s6-rc databases, which rc.init regenerates at
; boot (sdcompat-gen, init_t) and then swaps in by renaming symlinks. init_t
; may create symlinks in var_lib_t but not rename or unlink them, nor remove
; old database directories; label it like systemd's /var/lib/systemd.
(filecon "/var/lib/sdcompat(/.*)?" any (system_u object_r init_var_lib_t ((s0) (s0))))

; What the s6 tree does that systemd does not, so the policy has no rule for
; it: s6-linux-init's catch-all logger reads a fifo in /run/service, and the
; s6 services log to it (dbus-daemon and hostname enter their own domains);
; s6-svlink links dynamic service directories into /run/service; the run
; and finish scripts of dynamic services (user@UID.service) live in
; /run/sdcompat/dyn. At power-off, s6-linux-init-shutdownd renames every
; link in /run/service to a dot name so s6-svscan stops supervising it;
; denied, it prints "unable to rename ...: Permission denied" for each one.
(allow init_t var_run_t (fifo_file (read write ioctl)))
(allow system_dbusd_t var_run_t (fifo_file (write ioctl getattr)))
(allow hostname_t var_run_t (fifo_file (write ioctl getattr)))
(allow init_t var_run_t (lnk_file (create rename)))
(allow init_t init_var_run_t (file (execute execute_no_trans)))
