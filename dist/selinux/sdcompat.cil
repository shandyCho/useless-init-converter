; SELinux policy module for booting with s6 + sdcompat.
;
; systemd runs as init_t and every service enters its own domain through the
; policy's init_t transitions (chronyd_exec_t -> chronyd_t, xdm_exec_t ->
; xdm_t, user@.service -> the user's domain, ...). Under s6 the same holds only
; if the whole supervision tree stays in init_t: init_t executing a bin_t
; program becomes unconfined_service_t, so the s6, s6-rc, s6-linux-init and
; execline programs and sdcompat's own binaries are labelled init_exec_t, like
; /usr/lib/systemd/systemd. Run from any other domain they keep that domain
; (unconfined_t stays unconfined_t).
;
; /run/sdcompat holds the notify sockets services write to and is labelled
; like systemd's /run/systemd. s6-rc-update, run from a shell, enters init_t
; (below).
;
; Load:   semodule -i sdcompat.cil, then restorecon the files below
; Remove: semodule -r sdcompat

(filecon "/usr/bin/s6-[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/bin/ucspilogd" file (system_u object_r init_exec_t ((s0) (s0))))
; execline is built as one multicall binary (dist/rpm/execline.spec), so this
; one file covers every execline command, whatever a release names them.
(filecon "/usr/bin/execline" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/libexec/execline/[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/libexec/s6/[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/libexec/s6-rc/[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))
(filecon "/usr/libexec/sdcompat/[^/]+" file (system_u object_r init_exec_t ((s0) (s0))))

(filecon "/run/sdcompat(/.*)?" any (system_u object_r init_var_run_t ((s0) (s0))))
(typetransition init_t var_run_t dir "sdcompat" init_var_run_t)
;
; s6-linux-init's catch-all logger (s6-log, init_t) keeps its log in
; /run/uncaught-logs and rotates it by renaming "current". init_t may not
; rename var_run_t files; label it like /run/systemd. Without this the
; logger retries forever under enforcing and stops reading its fifo.
(filecon "/run/uncaught-logs(/.*)?" any (system_u object_r init_var_run_t ((s0) (s0))))
(typetransition init_t var_run_t dir "uncaught-logs" init_var_run_t)
;
; s6-rc's live directories (/run/s6-rc -> s6-rc:s6-rc-init:XXXXXX, and the
; s6-rc:s6-rc-update:XXXXXX that replace it). init_t creates them as
; init_var_run_t, but `early` runs restorecon -R /run after s6-rc-init, which
; made them var_run_t. s6-rc-update (daemon-reload) renames each running
; service's files aside before copying the new ones in; denied, it failed,
; could not roll back, and left that service directory in the new live dir.
(filecon "/run/s6-rc(:[^/]+)?(/.*)?" any (system_u object_r init_var_run_t ((s0) (s0))))
;
; /var/lib/sdcompat holds the s6-rc databases, which rc.init regenerates at
; boot (sdcompat-gen, init_t) and then swaps in by renaming symlinks. init_t
; may create symlinks in var_lib_t but not rename or unlink them, nor remove
; old database directories; label it like systemd's /var/lib/systemd.
(filecon "/var/lib/sdcompat(/.*)?" any (system_u object_r init_var_lib_t ((s0) (s0))))

; What the s6 tree does that systemd does not, so the policy has no rule for
; it: s6-linux-init's catch-all logger reads a fifo in /run/service, and the
; s6 services log to it; s6-svlink links dynamic service directories into
; /run/service; the run and finish scripts of dynamic services
; (user@UID.service) live in /run/sdcompat/dyn. At power-off,
; s6-linux-init-shutdownd renames every link in /run/service to a dot name
; so s6-svscan stops supervising it; denied, it prints "unable to rename
; ...: Permission denied" for each one.
(allow init_t var_run_t (lnk_file (create rename)))
(allow init_t init_var_run_t (file (execute execute_no_trans)))
;
; The catch-all fifo is every service's stderr (stdout too without a logger
; or the journal), inherited through each domain transition, as journald's
; stream socket is under systemd. Created by init_t in the /run tmpfs it
; became initctl_t (the policy's init_t tmpfs_t fifo_file transition, meant
; for /dev/initctl), which no service domain may write: the kernel swapped
; it for /dev/null (dbus-daemon, rsyslogd, agetty, loadkeys, restorecon, ...)
; and procps' pkill in logrotate logged a denial per process it looked at.
; Its own type, which every domain may write and stat through an inherited
; descriptor but not open by path.
(type sdcompat_log_fifo_t)
(roletype object_r sdcompat_log_fifo_t)
(typeattributeset file_type (sdcompat_log_fifo_t))
(typeattributeset non_security_file_type (sdcompat_log_fifo_t))
(typeattributeset non_auth_file_type (sdcompat_log_fifo_t))
(filecon "/run/service/s6-svscan-log/fifo" pipe (system_u object_r sdcompat_log_fifo_t ((s0) (s0))))
(typetransition init_t tmpfs_t fifo_file "fifo" sdcompat_log_fifo_t)
(allow init_t sdcompat_log_fifo_t (fifo_file (create open read write append ioctl getattr setattr lock unlink)))
(allow domain sdcompat_log_fifo_t (fifo_file (write append ioctl getattr)))
;
; A service directory's event/ is s6's fifodir: s6-svc -w, s6-svwait,
; s6-svlisten and s6-rc's waits (s6-ftrigr) create a fifo in it that
; s6-supervise (init_t) writes the events to. Created by init_t in the /run
; tmpfs it was tmpfs_t, so a waiter run from an admin's shell (unconfined_t)
; made its fifo user_tmp_t (the policy's unconfined_t tmpfs_t fifo_file
; transition), s6-supervise's writes were denied and the waiter never saw
; the event (setup's `s6-svc -wR` on sdcompatd timed out although the daemon
; was ready). init_var_run_t, as restorecon makes the rest of the live
; directory: fifos created there keep that type, which init_t may write.
(typetransition init_t tmpfs_t dir "event" init_var_run_t)
(filecon "/run/service/[^/]+/event" dir (system_u object_r init_var_run_t ((s0) (s0))))

; s6-rc-update and s6-rc-format-upgrade switch the live database: they
; create the scan directory's links and the live directory's service
; directories, which s6-svscan and s6-supervise (init_t) must read. Run
; from an admin's shell (`s6 live install`, `s6 set apply`,
; s6-rc-set-install), unconfined_t created them as user_tmp_t in the
; /run/service tmpfs and var_run_t in /run: init_t could not follow the
; links, s6-rc-update waited forever for supervisors that never started,
; and a later update in init_t could not roll back. Like a SysV init
; script run by root (initrc_exec_t -> initrc_t), these two enter init_t,
; the domain sdcompatd's own updates run in.
(type sdcompat_live_exec_t)
(roletype object_r sdcompat_live_exec_t)
(typeattributeset file_type (sdcompat_live_exec_t))
(typeattributeset exec_type (sdcompat_live_exec_t))
(typeattributeset entry_type (sdcompat_live_exec_t))
(typeattributeset non_security_file_type (sdcompat_live_exec_t))
(typeattributeset non_auth_file_type (sdcompat_live_exec_t))
(filecon "/usr/bin/s6-rc-update" file (system_u object_r sdcompat_live_exec_t ((s0) (s0))))
(filecon "/usr/bin/s6-rc-format-upgrade" file (system_u object_r sdcompat_live_exec_t ((s0) (s0))))
(allow init_t sdcompat_live_exec_t (file (entrypoint execute execute_no_trans getattr ioctl lock map open read)))
(typetransition unconfined_t sdcompat_live_exec_t process init_t)
(roletransition unconfined_r sdcompat_live_exec_t process system_r)
;
; The s6-rc repository (s6-rc-repo-init, `s6 set`), which sdcompatd syncs,
; commits and installs on daemon-reload: like /var/lib/sdcompat, init_t must
; rename and remove its symlinks and directories.
(filecon "/var/lib/s6-rc(/.*)?" any (system_u object_r init_var_lib_t ((s0) (s0))))
(typetransition init_t var_lib_t dir "s6-rc" init_var_lib_t)
(typetransition unconfined_t var_lib_t dir "s6-rc" init_var_lib_t)
;
; The rfkill s6 oneshot (dist/s6/rfkill, in place of systemd-rfkill, which
; runs as systemd_rfkill_t) restores and saves the radio state in
; systemd-rfkill's own files, so the systemd boot shares them. It runs in
; init_t, which may only stat that directory's files.
(allow init_t systemd_rfkill_var_lib_t (dir (getattr search open read write add_name remove_name)))
(allow init_t systemd_rfkill_var_lib_t (file (create getattr open read write append setattr)))
(typetransition init_t init_var_lib_t dir "rfkill" systemd_rfkill_var_lib_t)
